{
  "name": "app-devops-api",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --import ./telemetry.js server.js",
    "test": "NODE_ENV=test vitest run --pool=forks",
